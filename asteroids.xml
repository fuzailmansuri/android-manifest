<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <remote name="fuzail"
            fetch="https://github.com/fuzailmansuri/"
            sync-c="true"
            sync-tags="false"
            revision="yaap-17" />

    <remote name="crdroid"
            fetch="https://github.com/crdroidandroid/"
            sync-c="true"
            sync-tags="false" />

    <!-- Device Tree -->
    <project name="android_device_nothing_asteroids"
             path="device/nothing/asteroids"
             remote="fuzail" />

    <!-- Kernel Source -->
    <project name="android_kernel_nothing_sm7635"
             path="kernel/nothing/sm7635"
             remote="fuzail"
             revision="seventeen" />

    <!-- Kernel Modules -->
    <project name="android_kernel_nothing_sm7635-modules"
             path="kernel/nothing/sm7635-modules"
             remote="fuzail"
             revision="seventeen" />

    <!-- Kernel Device Trees -->
    <project name="android_kernel_nothing_sm7635-devicetrees"
             path="kernel/nothing/sm7635-devicetrees"
             remote="fuzail"
             revision="seventeen" />

    <!-- Vendor Files -->
    <project name="proprietary_vendor_nothing_asteroids"
             path="vendor/nothing/asteroids"
             remote="fuzail" />

    <!-- Vendor Nothing Camera -->
    <project name="vendor_nothing_camera"
             path="vendor/nothing/camera"
             remote="fuzail"
             revision="main" />

    <!-- Hardware Nothing (Glyph, AssistKey, Vibrator, etc.) -->
    <project name="android_hardware_nothing"
             path="hardware/nothing"
             remote="fuzail" />

    <!-- Hardware Dolby -->
    <project name="hardware_dolby"
             path="hardware/dolby"
             remote="fuzail" />

    <!-- Dolby App -->
    <project name="android_packages_apps_LunarisDolby"
             path="packages/apps/LunarisDolby"
             remote="crdroid"
             revision="17.0" />

    <!-- Runtime integration fixes -->
    <remove-project path="hardware/lineage/compat" />
    <project name="hardware_lineage_compat"
             path="hardware/lineage/compat"
             remote="fuzail"
             revision="seventeen" />

    <remove-project path="frameworks/native" />
    <project name="frameworks_native"
             path="frameworks/native"
             remote="fuzail"
             revision="seventeen" />

    <remove-project path="device/lineage/sepolicy" />
    <project name="device_lineage_sepolicy"
             path="device/lineage/sepolicy"
             remote="fuzail"
             revision="seventeen" />

    <remove-project path="system/sepolicy" />
    <project name="system_sepolicy"
             path="system/sepolicy"
             remote="fuzail"
             revision="seventeen" />

    <remove-project path="vendor/yaap" />
    <project name="vendor_yaap"
             path="vendor/yaap"
             remote="fuzail"
             revision="seventeen" />

    <remove-project path="system/core" />
    <project name="android_system_core"
             path="system/core"
             remote="fuzail"
             revision="seventeen" />

    <remove-project path="system/netd" />
    <project name="system_netd"
             path="system/netd"
             remote="fuzail"
             revision="seventeen" />

    <!-- Shared UI source and YAAP adapters -->
    <project name="android_packages_apps_Customizations"
             path="packages/apps/Customizations"
             remote="fuzail"
             revision="main" />

</manifest>
