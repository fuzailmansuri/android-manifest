+internal fun Drawable.toScaledBitmap(sizeDp: Dp): ImageBitmap {
+    val px = with(LocalDensity.current) { sizeDp.roundToPx() }
+    return remember(this, px) { toBitmap(px, px).asImageBitmap() }
+}
