@@ -0,0 +1,119 @@
+package com.android.systemui.axdynamicbar.shared
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.RenderEffect
+import android.graphics.RenderNode
+import android.graphics.Shader
+import android.graphics.drawable.Drawable
+import android.graphics.drawable.GradientDrawable
+import android.os.Build
+import android.view.View
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.compositionLocalOf
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.toArgb
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.viewinterop.AndroidView
+
+/** Ambient blur alpha for the dynamic-bar surfaces. */
+internal val LocalBlurAlpha = compositionLocalOf { 1f }
+
+/**
+ * A View that renders a frosted-glass backdrop behind dynamic-bar cards.
+ *
+ * Uses [RenderEffect.createBlurEffect] (API 31+) for real background blur when
+ * the platform supports it, and falls back to a solid opaque colour on older
+ * devices or when the window does not expose a backdrop (e.g. software rendering).
+ *
+ * The blur radius is deliberately kept small (16 px) so it stays cheap — the
+ * expanded-panel window is small and is already composited on top of the wallpaper.
+ */
+internal class AxBlurHost(context: Context) : View(context) {
+
+    private val bgDrawable: GradientDrawable = GradientDrawable().also { it.setColor(0x00000000) }
+
+    private var fallbackColor = 0
+    private var blurAlpha = 1f
+    private var cornerRadiusPx = 0f
+
+    // RenderEffect-based blur (API 31+).
+    private val blurEffect: RenderEffect? =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            RenderEffect.createBlurEffect(16f, 16f, Shader.TileMode.CLAMP)
+        } else null
+
+    fun configure(newCornerRadius: Float, fallback: Int, alpha: Float) {
+        var dirty = false
+        if (cornerRadiusPx != newCornerRadius) {
+            cornerRadiusPx = newCornerRadius
+            bgDrawable.cornerRadius = newCornerRadius
+            dirty = true
+        }
+        if (fallbackColor != fallback) {
+            fallbackColor = fallback
+            dirty = true
+        }
+        if (blurAlpha != alpha) {
+            blurAlpha = alpha
+            this.alpha = alpha
+        }
+        if (dirty) invalidate()
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        // Apply blur to this view's own rendering node so the compositor blurs
+        // whatever is drawn behind this window region.
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S && blurEffect != null) {
+            setRenderEffect(blurEffect)
+        }
+    }
+
+    override fun onDetachedFromWindow() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            setRenderEffect(null)
+        }
+        super.onDetachedFromWindow()
+    }
+
+    override fun draw(canvas: Canvas) {
+        if (blurAlpha <= 0f || width <= 0 || height <= 0) return
+        bgDrawable.setBounds(0, 0, width, height)
+        if (blurEffect != null) {
+            // With RenderEffect active, draw a semi-transparent tinted overlay so
+            // the blurred region has some colour tint (matches crDroid surfaceLightTint).
+            bgDrawable.setColor(0x26FFFFFF) // ~15% white tint
+            bgDrawable.draw(canvas)
+            bgDrawable.setColor(0x00000000)
+        } else {
+            // Fallback: solid colour so the card is readable on devices without blur.
+            bgDrawable.setColor(fallbackColor)
+            bgDrawable.draw(canvas)
+            bgDrawable.setColor(0x00000000)
+        }
+    }
+}
+
+/**
+ * Composable wrapper around [AxBlurHost]. Placed behind dynamic-bar card content
+ * to give a frosted-glass look. Falls back gracefully to [fallbackColor] when
+ * hardware blur is unavailable.
+ */
+@Composable
+internal fun AxBlurBackdrop(
+    cornerRadius: Dp,
+    fallbackColor: Color,
+    modifier: Modifier = Modifier,
+    alpha: Float = LocalBlurAlpha.current,
+) {
+    val radiusPx = with(LocalDensity.current) { cornerRadius.toPx() }
+    val fallback = fallbackColor.toArgb()
+    AndroidView(
+        factory = { ctx -> AxBlurHost(ctx).also { it.configure(radiusPx, fallback, alpha) } },
+        update = { it.configure(radiusPx, fallback, alpha) },
+        modifier = modifier,
+    )
+}
