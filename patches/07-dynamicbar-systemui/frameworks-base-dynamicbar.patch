+package com.android.systemui.common.ui.view
+
+import android.view.View
+import android.view.ViewTreeObserver
+import com.android.internal.graphics.drawable.BackgroundBlurDrawable
+import kotlin.math.roundToInt
+
+/**
+ * Synchronizes the effective alpha of a view hierarchy down to a [BackgroundBlurDrawable].
+ *
+ * SurfaceFlinger renders [BackgroundBlurDrawable] using its own alpha channel. When parent views
+ * animate or fade out (e.g. keyguard dismiss, notification swipe, or shade transitions), child
+ * RenderNode alpha does not automatically propagate to the SurfaceControl blur, leaving a dark,
+ * shadowy blur rectangle artifact behind. This listener ensures the blur drawable's alpha matches
+ * the cumulative alpha of all ancestors.
+ */
+class BackgroundBlurAlphaSync(
+    private val view: View,
+    private val drawable: () -> BackgroundBlurDrawable?,
+) : ViewTreeObserver.OnPreDrawListener {
+
+    override fun onPreDraw(): Boolean {
+        sync()
+        return true
+    }
+
+    fun sync() {
+        val blur = drawable() ?: return
+        var alpha = 1f
+        var v: View? = view
+        while (v != null && alpha > 0f) {
+            alpha *= v.alpha * v.transitionAlpha
+            v = v.parent as? View
+        }
+        val blurAlpha = (255 * alpha.coerceIn(0f, 1f)).roundToInt()
+        if (blur.alpha != blurAlpha) {
+            blur.alpha = blurAlpha
+        }
+    }
+
+    /**
+     * Attaches the pre-draw listener and immediately synchronizes the initial alpha.
+     * Returns a [Runnable] to detach the listener.
+     */
+    fun start(): Runnable {
+        val observer = view.viewTreeObserver
+        observer.addOnPreDrawListener(this)
+        sync()
+        return Runnable {
+            val obs = if (observer.isAlive) observer else view.viewTreeObserver
+            obs.removeOnPreDrawListener(this)
+        }
+    }
+}
