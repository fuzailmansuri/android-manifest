+internal data class IslandColorScheme(
+    /** The saturated fill. */
+    val accent: Color,
+    /** Content legible *on* [accent] — note `onTint`, not `onContainer`: [accent] is [IslandTone.tint]. */
+    val onAccent: Color,
+    /** A faint wash of [accent], for tinting a surface rather than filling it. */
+    val tonal: Color,
