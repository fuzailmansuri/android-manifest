+            Offset(cx + (r * 0.7f * cos(rad)).toFloat(), cy + (r * 0.7f * sin(rad)).toFloat()),
+            strokeWidth = SizeStrokeThin.dp.toPx(),
+            cap = StrokeCap.Round,
+        )
+        drawCircle(drawColor, radius = SizeStrokeThin.dp.toPx(), center = Offset(cx, cy))
+    }
