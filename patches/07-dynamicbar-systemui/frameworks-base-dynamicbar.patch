+        return sbn.notification
+            ?.actions
+            ?.filter { a -> a.remoteInputs.isNullOrEmpty() && a.actionIntent != null }
+            ?.take(3)
+            ?.mapNotNull { a ->
+                a.title?.let { IslandEvent.NotificationAction(label = it, action = a) }
+            } ?: emptyList()
+    }
