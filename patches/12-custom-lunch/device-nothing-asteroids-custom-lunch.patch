From d8c4eb22bb67759260375ef9777d3f17c546a87d Mon Sep 17 00:00:00 2001
From: fuzailmansuri <mfm9875@gmail.com>
Date: Sun, 4 Oct 2026 18:26:18 +0000
Subject: [PATCH] asteroids: Add custom lunch target

Define custom_asteroids product makefile and lunch combo.
---
 AndroidProducts.mk  | 3 +++
 custom_asteroids.mk | 3 +++
 2 files changed, 6 insertions(+)

diff --git a/AndroidProducts.mk b/AndroidProducts.mk
index 17e1bcc..a38e48c 100644
--- a/AndroidProducts.mk
+++ b/AndroidProducts.mk
@@ -9,6 +9,9 @@ PRODUCT_MAKEFILES := \
     $(LOCAL_DIR)/custom_asteroids.mk
 
 COMMON_LUNCH_CHOICES := \
+    custom_asteroids-cp2a-user \
+    custom_asteroids-cp2a-userdebug \
+    custom_asteroids-cp2a-eng \
     lineage_asteroids-cp2a-user \
     lineage_asteroids-cp2a-userdebug \
     lineage_asteroids-cp2a-eng
diff --git a/custom_asteroids.mk b/custom_asteroids.mk
index ae8550d..69dd7a1 100644
--- a/custom_asteroids.mk
+++ b/custom_asteroids.mk
@@ -6,6 +6,9 @@
 $(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit_only.mk)
 $(call inherit-product, $(SRC_TARGET_DIR)/product/full_base_telephony.mk)
 
+TARGET_SCREEN_WIDTH := 1080
+TARGET_SCREEN_HEIGHT := 2412
+
 $(call inherit-product, device/nothing/asteroids/device.mk)
 $(call inherit-product, vendor/custom/config/common_full_phone.mk)
 
-- 
