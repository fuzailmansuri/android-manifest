+
+#include "../PowerHintSessionWalt.h"
+#include "../utils.h"
+
+#include <fmq/AidlMessageQueue.h>
+#include <gtest/gtest.h>
+#include <chrono>
+#include <climits>
+#include <condition_variable>
+#include <map>
+#include <optional>
+
+using namespace aidl::android::hardware::power;
+using aidl::android::hardware::common::fmq::SynchronizedReadWrite;
+using Contents = ChannelMessage::ChannelMessageContents;
+using Tag = Contents::Tag;
+
+namespace {
+std::mutex sPerfLock;
+std::condition_variable sPerfChanged;
+std::map<int, std::vector<int>> sLocks;
+std::vector<std::vector<int>> sRequests;
+int sNextHandle = 1;
+std::optional<int> sFailure;
+}  // namespace
+
+extern "C" int interaction_with_handle(int, int duration, int count, int resources[]) {
+    std::lock_guard lock(sPerfLock);
+    EXPECT_EQ(duration, 0);
+    sRequests.emplace_back(resources, resources + count);
+    if (sFailure.has_value()) {
+        const int result = *sFailure;
+        sFailure.reset();
+        return result;
+    }
+    const int handle = sNextHandle++;
+    sLocks.emplace(handle, sRequests.back());
+    sPerfChanged.notify_all();
+    return handle;
+}
+
+extern "C" void release_request(int handle) {
+    std::lock_guard lock(sPerfLock);
+    EXPECT_EQ(sLocks.erase(handle), 1u);
+    sPerfChanged.notify_all();
+}
+
+class WaltSessionTest : public testing::Test {
+  protected:
+    void SetUp() override {
+        std::lock_guard lock(sPerfLock);
+        ASSERT_TRUE(sLocks.empty());
+        sRequests.clear();
+        sFailure.reset();
+    }
+
+    void TearDown() override {
+        std::lock_guard lock(sPerfLock);
+        EXPECT_TRUE(sLocks.empty());
+    }
+
+    std::shared_ptr<IPowerHintSession> session(int32_t tgid = 100, int32_t uid = 1000) {
+        return setPowerHintSession(tgid, uid, {101, 102}, 16000000);
+    }
+
+    std::vector<int> request() {
+        std::lock_guard lock(sPerfLock);
+        return sRequests.empty() ? std::vector<int>{} : sRequests.back();
+    }
+
+    ChannelMessage hint(const std::shared_ptr<IPowerHintSession>& session, int64_t timestamp = 1) {
+        SessionConfig config;
+        EXPECT_TRUE(session->getSessionConfig(&config).isOk());
+        ChannelMessage message;
+        message.sessionID = static_cast<int32_t>(config.id);
+        message.timeStampNanos = timestamp;
+        message.data = Contents::make<Tag::hint>(SessionHint::CPU_LOAD_UP);
+        return message;
+    }
+};
+
+TEST_F(WaltSessionTest, ValidatesCreationAndThreadReplacement) {
+    EXPECT_EQ(setPowerHintSession(100, 1000, {}, 1), nullptr);
+    EXPECT_EQ(setPowerHintSession(100, 1000, {0}, 1), nullptr);
+    EXPECT_EQ(setPowerHintSession(100, 1000, {INT_MAX}, 1), nullptr);
+    EXPECT_EQ(setPowerHintSession(100, 1000, {101}, 0), nullptr);
+    auto s = session();
+    ASSERT_NE(s, nullptr);
+    EXPECT_EQ(s->setThreads({}).getExceptionCode(), EX_ILLEGAL_ARGUMENT);
+    EXPECT_EQ(s->setThreads({-1}).getExceptionCode(), EX_ILLEGAL_ARGUMENT);
+    s->sendHint(SessionHint::CPU_LOAD_UP);
+    EXPECT_EQ(request(),
+              (std::vector<int>{0x43C04000, (101 << 8) | 10, 0x43C04000, (102 << 8) | 10}));
+}
+
+TEST_F(WaltSessionTest, FailedReplacementDoesNotLeaveFictitiousBoost) {
+    auto s = session();
+    s->sendHint(SessionHint::CPU_LOAD_UP);
+    {
+        std::lock_guard lock(sPerfLock);
+        sFailure = -1;
+    }
+    s->sendHint(SessionHint::CPU_LOAD_UP);
+    {
+        std::lock_guard lock(sPerfLock);
+        EXPECT_TRUE(sLocks.empty());
+        sFailure.reset();
+    }
+    s->sendHint(SessionHint::CPU_LOAD_UP);
+    ASSERT_FALSE(request().empty());
+    EXPECT_EQ(request()[1] & 0xff, 10);
+}
+
+TEST_F(WaltSessionTest, ZeroHandleIsFailure) {
+    auto s = session();
+    // Make the fake return zero, as the real helper can when no client is loaded.
+    {
+        std::lock_guard lock(sPerfLock);
+        sFailure = 0;
+    }
+    s->sendHint(SessionHint::CPU_LOAD_UP);
+    s->sendHint(SessionHint::CPU_LOAD_UP);
+    EXPECT_EQ(request()[1] & 0xff, 10);
+}
+
+TEST_F(WaltSessionTest, PauseResumeCloseAndReplacementReleaseHandles) {
+    auto s = session();
+    s->sendHint(SessionHint::CPU_LOAD_UP);
+    s->pause();
+    s->pause();
+    s->sendHint(SessionHint::CPU_LOAD_UP);
+    s->resume();
+    EXPECT_EQ(request()[1] & 0xff, 10);
+    s->setThreads({103});
+    s->sendHint(SessionHint::CPU_LOAD_DOWN);
+    EXPECT_EQ(request(), (std::vector<int>{0x43C04000, (103 << 8) | 0x80 | 10}));
+    s->pause();
+    s->close();
+    s->resume();
+    s->sendHint(SessionHint::CPU_LOAD_UP);
+    EXPECT_EQ(s->setThreads({104}).getExceptionCode(), EX_ILLEGAL_STATE);
+}
+
+TEST_F(WaltSessionTest, TimingFeedbackAndBounds) {
+    auto s = session();
+    WorkDuration duration;
+    duration.durationNanos = 16000000;
+    for (int i = 0; i < 20; ++i) s->reportActualWorkDuration({duration});
+    EXPECT_EQ(request()[1] & 0xff, 80);
+    duration.durationNanos = 1000;
+    for (int i = 0; i < 3; ++i) s->reportActualWorkDuration({duration});
+    EXPECT_EQ(request()[1] & 0xff, 70);
+    duration.durationNanos = -1;
+    s->reportActualWorkDuration({duration});
+    EXPECT_EQ(request()[1] & 0xff, 70);
+    s->sendHint(SessionHint::GPU_LOAD_SPIKE);
+    s->setMode(SessionMode::GRAPHICS_PIPELINE, true);
+    EXPECT_EQ(request()[1] & 0xff, 70);
+}
+
+TEST_F(WaltSessionTest, FmqRoutesByIdAndOwnerAndStopsOnClose) {
+    auto owner = session();
+    auto foreign = session(200, 1000);
+    SessionConfig ownerConfig, foreignConfig;
+    owner->getSessionConfig(&ownerConfig);
+    foreign->getSessionConfig(&foreignConfig);
+    EXPECT_NE(ownerConfig.id, foreignConfig.id);
+    ChannelConfig config, repeated;
+    ASSERT_TRUE(getPowerSessionChannel(100, 1000, &config).isOk());
+    ASSERT_TRUE(getPowerSessionChannel(100, 1000, &repeated).isOk());
+    android::AidlMessageQueue<ChannelMessage, SynchronizedReadWrite> queue(config.channelDescriptor,
+                                                                           false);
+    android::AidlMessageQueue<ChannelMessage, SynchronizedReadWrite> sameQueue(
+            repeated.channelDescriptor, false);
+    ASSERT_TRUE(queue.isValid());
+    ASSERT_TRUE(sameQueue.isValid());
+    auto wrongOwner = hint(foreign);
+    auto valid = hint(owner);
+    ASSERT_TRUE(queue.writeBlocking(&wrongOwner, 1, config.readFlagBitmask, config.writeFlagBitmask,
+                                    100000000));
+    ASSERT_TRUE(sameQueue.writeBlocking(&valid, 1, repeated.readFlagBitmask,
+                                        repeated.writeFlagBitmask, 100000000));
+    {
+        std::unique_lock lock(sPerfLock);
+        EXPECT_TRUE(sPerfChanged.wait_for(lock, std::chrono::seconds(1),
+                                          [] { return !sLocks.empty(); }));
+    }
+    EXPECT_TRUE(closePowerSessionChannel(100, 1000).isOk());
+    {
+        std::lock_guard lock(sPerfLock);
+        EXPECT_EQ(sRequests.size(), 1u);
+    }
+    owner->close();
+    EXPECT_TRUE(getPowerSessionChannel(100, 1000, &config).isOk());
+    EXPECT_TRUE(closePowerSessionChannel(100, 1000).isOk());
+}
+
+TEST_F(WaltSessionTest, FmqDispatchesTimingAndRejectsMalformedAndStaleMessages) {
+    auto s = session();
+    ChannelConfig config;
+    ASSERT_TRUE(getPowerSessionChannel(100, 1000, &config).isOk());
+    android::AidlMessageQueue<ChannelMessage, SynchronizedReadWrite> queue(config.channelDescriptor,
+                                                                           false);
+    std::vector<ChannelMessage> messages;
+    auto message = hint(s, 10);
+    message.data = Contents::make<Tag::targetDuration>(int64_t{4000000});
+    messages.push_back(message);
+    WorkDurationFixedV1 duration;
+    duration.durationNanos = 5000000;
+    duration.cpuDurationNanos = 5000000;
+    message.data = Contents::make<Tag::workDuration>(duration);
+    messages.push_back(message);
+    Contents::SessionModeSetter mode;
+    mode.modeInt = SessionMode::GRAPHICS_PIPELINE;
+    mode.enabled = true;
+    message.data = Contents::make<Tag::mode>(mode);
+    messages.push_back(message);
+    duration.durationNanos = -1;
+    message.data = Contents::make<Tag::workDuration>(duration);
+    messages.push_back(message);
+    messages.push_back(hint(s, 0));
+    messages.push_back(hint(s, 9));
+    messages.push_back(hint(s, 11));
+    EXPECT_TRUE(queue.writeBlocking(messages.data(), messages.size(), config.readFlagBitmask,
+                                    config.writeFlagBitmask, 100000000));
+    {
+        std::unique_lock lock(sPerfLock);
+        EXPECT_TRUE(sPerfChanged.wait_for(lock, std::chrono::seconds(1),
+                                          [] { return sRequests.size() >= 2; }));
+    }
+    closePowerSessionChannel(100, 1000);
+    {
+        std::lock_guard lock(sPerfLock);
+        ASSERT_EQ(sRequests.size(), 2u);
+        EXPECT_EQ(sRequests.back()[1] & 0xff, 20);
+    }
+}
