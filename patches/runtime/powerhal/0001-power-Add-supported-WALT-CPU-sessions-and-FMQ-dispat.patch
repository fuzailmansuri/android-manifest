diff --git a/PowerHintSessionWalt.cpp b/PowerHintSessionWalt.cpp
new file mode 100644
index 0000000..6499a3f
--- /dev/null
+++ b/PowerHintSessionWalt.cpp
@@ -0,0 +1,340 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause-Clear
+ */
+
+#define LOG_TAG "QTI PowerHAL"
+
+#include "PowerHintSessionWalt.h"
+#include "utils.h"
+
+#include <android-base/logging.h>
+#include <fmq/AidlMessageQueue.h>
+#include <fmq/EventFlag.h>
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <climits>
+#include <cstdlib>
+#include <map>
+#include <thread>
+#include <unordered_map>
+
+using namespace aidl::android::hardware::power;
+using aidl::android::hardware::common::fmq::SynchronizedReadWrite;
+using android::AidlMessageQueue;
+using android::hardware::EventFlag;
+
+namespace {
+constexpr int kTaskLoadBoost = 0x43C04000;
+constexpr size_t kMaxBoostThreads = 5;
+constexpr int kMaxBoost = 80;
+constexpr int kBoostStep = 10;
+constexpr uint32_t kReadMask = 0x01;
+constexpr uint32_t kWriteMask = 0x02;
+
+std::mutex sSessionLock;
+int64_t sNextSessionId = 1;
+std::unordered_map<int32_t, std::weak_ptr<PowerHintSessionImpl>> sSessions;
+
+class SessionChannel {
+  public:
+    SessionChannel(int32_t tgid, int32_t uid) : mTgid(tgid), mUid(uid) {
+        if (mQueue.isValid() &&
+            EventFlag::createEventFlag(mQueue.getEventFlagWord(), &mFlag) == android::OK) {
+            mWorker = std::thread([this] { run(); });
+        }
+    }
+
+    ~SessionChannel() {
+        mStopping = true;
+        if (mFlag) mFlag->wake(kWriteMask);
+        if (mWorker.joinable()) mWorker.join();
+        if (mFlag) EventFlag::deleteEventFlag(&mFlag);
+    }
+
+    bool isValid() const { return mQueue.isValid() && mFlag; }
+
+    void getConfig(ChannelConfig* config) {
+        config->channelDescriptor = mQueue.dupeDesc();
+        config->eventFlagDescriptor = std::nullopt;
+        config->readFlagBitmask = kReadMask;
+        config->writeFlagBitmask = kWriteMask;
+    }
+
+  private:
+    void run() {
+        while (!mStopping) {
+            uint32_t state = 0;
+            mFlag->wait(kWriteMask, &state, 0, true);
+            while (!mStopping && mQueue.availableToRead() > 0) {
+                ChannelMessage message;
+                if (!mQueue.read(&message, 1)) break;
+                mFlag->wake(kReadMask);
+                std::shared_ptr<PowerHintSessionImpl> session;
+                {
+                    std::lock_guard lock(sSessionLock);
+                    auto it = sSessions.find(message.sessionID);
+                    if (it != sSessions.end()) session = it->second.lock();
+                }
+                // An app can write arbitrary IDs into its FMQ.
+                if (session && session->belongsTo(mTgid, mUid)) session->dispatch(message);
+            }
+        }
+    }
+
+    const int32_t mTgid;
+    const int32_t mUid;
+    AidlMessageQueue<ChannelMessage, SynchronizedReadWrite> mQueue{20, true};
+    EventFlag* mFlag = nullptr;
+    std::atomic<bool> mStopping{false};
+    std::thread mWorker;
+};
+
+std::mutex sChannelLock;
+std::map<std::pair<int32_t, int32_t>, std::unique_ptr<SessionChannel>> sChannels;
+}  // namespace
+
+bool validPowerSessionThreads(const std::vector<int32_t>& threadIds) {
+    return !threadIds.empty() && std::all_of(threadIds.begin(), threadIds.end(), [](int32_t tid) {
+        // The resource packs a positive TID into the upper 24 bits.
+        return tid > 0 && tid <= (INT_MAX >> 8);
+    });
+}
+
+std::shared_ptr<IPowerHintSession> setPowerHintSession(int32_t tgid, int32_t uid,
+                                                       const std::vector<int32_t>& threadIds,
+                                                       int64_t durationNanos) {
+    if (tgid <= 0 || uid < 0 || durationNanos <= 0 || !validPowerSessionThreads(threadIds)) {
+        return nullptr;
+    }
+    int32_t id;
+    {
+        std::lock_guard lock(sSessionLock);
+        // Never reuse an ID: stale FMQ messages must not reach a new session.
+        if (sNextSessionId > INT_MAX) return nullptr;
+        id = static_cast<int32_t>(sNextSessionId++);
+    }
+    auto session =
+            ndk::SharedRefBase::make<PowerHintSessionImpl>(id, tgid, uid, threadIds, durationNanos);
+    {
+        std::lock_guard lock(sSessionLock);
+        sSessions.emplace(id, session);
+    }
+    return session;
+}
+
+int64_t getSessionPreferredRate() {
+    return 16666666L;
+}
+
+PowerHintSessionImpl::PowerHintSessionImpl(int32_t id, int32_t tgid, int32_t uid,
+                                           const std::vector<int32_t>& threadIds,
+                                           int64_t durationNanos)
+    : mId(id), mTgid(tgid), mUid(uid), mThreadIds(threadIds), mTargetDuration(durationNanos) {}
+
+PowerHintSessionImpl::~PowerHintSessionImpl() {
+    close();
+}
+
+bool PowerHintSessionImpl::belongsTo(int32_t tgid, int32_t uid) const {
+    return mTgid == tgid && mUid == uid;
+}
+
+void PowerHintSessionImpl::releaseBoostLocked() {
+    if (mHandle > 0) release_request(mHandle);
+    mHandle = -1;
+}
+
+bool PowerHintSessionImpl::applyBoostLocked(int boost) {
+    boost = std::clamp(boost, -kMaxBoost, kMaxBoost);
+    if (boost == mBoost && (boost == 0 || mHandle > 0)) return true;
+    releaseBoostLocked();
+    mBoost = 0;
+    if (boost == 0) return true;
+
+    std::array<int, kMaxBoostThreads * 2> resources{};
+    const size_t count = std::min(mThreadIds.size(), kMaxBoostThreads);
+    for (size_t i = 0; i < count; ++i) {
+        resources[2 * i] = kTaskLoadBoost;
+        resources[2 * i + 1] = (mThreadIds[i] << 8) | std::abs(boost) | (boost < 0 ? 0x80 : 0);
+    }
+    const int handle =
+            interaction_with_handle(-1, 0, static_cast<int>(count * 2), resources.data());
+    if (handle <= 0) {
+        LOG(ERROR) << "Unable to acquire WALT task-load boost";
+        return false;
+    }
+    mHandle = handle;
+    mBoost = boost;
+    return true;
+}
+
+ndk::ScopedAStatus PowerHintSessionImpl::updateTargetWorkDuration(int64_t durationNanos) {
+    std::lock_guard lock(mLock);
+    if (!mClosed && durationNanos > 0 && mTargetDuration != durationNanos) {
+        mTargetDuration = durationNanos;
+        mDownCount = 0;
+    }
+    return ndk::ScopedAStatus::ok();
+}
+
+ndk::ScopedAStatus PowerHintSessionImpl::reportActualWorkDuration(
+        const std::vector<WorkDuration>& durations) {
+    std::lock_guard lock(mLock);
+    if (mClosed || mPaused || durations.empty()) return ndk::ScopedAStatus::ok();
+    int64_t actual = 0;
+    for (const auto& duration : durations) {
+        if (duration.durationNanos <= 0 || duration.cpuDurationNanos < 0 ||
+            duration.gpuDurationNanos < 0 || duration.timeStampNanos < 0 ||
+            duration.workPeriodStartTimestampNanos < 0) {
+            return ndk::ScopedAStatus::ok();
+        }
+        actual = std::max(actual, duration.durationNanos);
+    }
+    if (actual >= mTargetDuration - mTargetDuration / 8) {
+        applyBoostLocked(mBoost + kBoostStep);
+        mDownCount = 0;
+    } else if (++mDownCount >= 3) {
+        applyBoostLocked(mBoost - kBoostStep);
+        mDownCount = 0;
+    }
+    return ndk::ScopedAStatus::ok();
+}
+
+ndk::ScopedAStatus PowerHintSessionImpl::pause() {
+    std::lock_guard lock(mLock);
+    if (!mClosed) {
+        releaseBoostLocked();
+        mPaused = true;
+        mDownCount = 0;
+    }
+    return ndk::ScopedAStatus::ok();
+}
+
+ndk::ScopedAStatus PowerHintSessionImpl::resume() {
+    std::lock_guard lock(mLock);
+    if (!mClosed && mPaused) {
+        mPaused = false;
+        applyBoostLocked(mBoost);
+    }
+    return ndk::ScopedAStatus::ok();
+}
+
+ndk::ScopedAStatus PowerHintSessionImpl::close() {
+    std::lock_guard lock(mLock);
+    if (!mClosed) {
+        mClosed = true;
+        releaseBoostLocked();
+        mBoost = 0;
+        mThreadIds.clear();
+        std::lock_guard registryLock(sSessionLock);
+        sSessions.erase(mId);
+    }
+    return ndk::ScopedAStatus::ok();
+}
+
+ndk::ScopedAStatus PowerHintSessionImpl::sendHint(SessionHint hint) {
+    std::lock_guard lock(mLock);
+    if (mClosed || mPaused) return ndk::ScopedAStatus::ok();
+    switch (hint) {
+        case SessionHint::CPU_LOAD_UP:
+            applyBoostLocked(mBoost + kBoostStep);
+            mDownCount = 0;
+            break;
+        case SessionHint::CPU_LOAD_DOWN:
+            applyBoostLocked(mBoost - kBoostStep);
+            mDownCount = 0;
+            break;
+        case SessionHint::CPU_LOAD_RESET:
+            applyBoostLocked(0);
+            mDownCount = 0;
+            break;
+        case SessionHint::CPU_LOAD_RESUME:
+            applyBoostLocked(mBoost);
+            mDownCount = 0;
+            break;
+        default:
+            break;
+    }
+    return ndk::ScopedAStatus::ok();
+}
+
+ndk::ScopedAStatus PowerHintSessionImpl::setThreads(const std::vector<int32_t>& threadIds) {
+    if (!validPowerSessionThreads(threadIds)) {
+        return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+    }
+    std::lock_guard lock(mLock);
+    if (mClosed) return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_STATE);
+    releaseBoostLocked();
+    mBoost = 0;
+    mDownCount = 0;
+    mThreadIds = threadIds;
+    return ndk::ScopedAStatus::ok();
+}
+
+ndk::ScopedAStatus PowerHintSessionImpl::setMode(SessionMode, bool) {
+    // No Picard pipeline or efficiency contract is implemented by this backend.
+    return ndk::ScopedAStatus::ok();
+}
+
+ndk::ScopedAStatus PowerHintSessionImpl::getSessionConfig(SessionConfig* config) {
+    config->id = mId;
+    return ndk::ScopedAStatus::ok();
+}
+
+void PowerHintSessionImpl::dispatch(const ChannelMessage& message) {
+    {
+        std::lock_guard lock(mLock);
+        if (mClosed || message.timeStampNanos <= 0 ||
+            message.timeStampNanos < mLastChannelTimestamp)
+            return;
+        mLastChannelTimestamp = message.timeStampNanos;
+    }
+    using Tag = ChannelMessage::ChannelMessageContents::Tag;
+    switch (message.data.getTag()) {
+        case Tag::targetDuration:
+            updateTargetWorkDuration(message.data.get<Tag::targetDuration>());
+            break;
+        case Tag::hint:
+            sendHint(message.data.get<Tag::hint>());
+            break;
+        case Tag::mode: {
+            const auto& mode = message.data.get<Tag::mode>();
+            setMode(mode.modeInt, mode.enabled);
+            break;
+        }
+        case Tag::workDuration: {
+            const auto& data = message.data.get<Tag::workDuration>();
+            WorkDuration duration;
+            duration.timeStampNanos = message.timeStampNanos;
+            duration.durationNanos = data.durationNanos;
+            duration.cpuDurationNanos = data.cpuDurationNanos;
+            duration.gpuDurationNanos = data.gpuDurationNanos;
+            duration.workPeriodStartTimestampNanos = data.workPeriodStartTimestampNanos;
+            reportActualWorkDuration({duration});
+            break;
+        }
+        default:
+            break;
+    }
+}
+
+ndk::ScopedAStatus getPowerSessionChannel(int32_t tgid, int32_t uid, ChannelConfig* config) {
+    if (tgid <= 0 || uid < 0) return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+    std::lock_guard lock(sChannelLock);
+    const auto key = std::make_pair(tgid, uid);
+    auto it = sChannels.find(key);
+    if (it == sChannels.end()) {
+        auto channel = std::make_unique<SessionChannel>(tgid, uid);
+        if (!channel->isValid()) return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_STATE);
+        it = sChannels.emplace(key, std::move(channel)).first;
+    }
+    it->second->getConfig(config);
+    return ndk::ScopedAStatus::ok();
+}
+
+ndk::ScopedAStatus closePowerSessionChannel(int32_t tgid, int32_t uid) {
+    std::lock_guard lock(sChannelLock);
+    sChannels.erase(std::make_pair(tgid, uid));
+    return ndk::ScopedAStatus::ok();
+}
