From b8cbe14792c525c7f65b8aac187f427fecfb2e8e Mon Sep 17 00:00:00 2001
From: Michael Bestas <mkbestas@lineageos.org>
Date: Wed, 1 Jul 2026 06:34:43 +0300
Subject: [PATCH 1/4] sepolicy: Relabel aux & privapp camera properties

Matches QSSI 17 label for the aux properties.

Change-Id: I34bdb71644388a8ef77ba3ab6d762b68c2b44670
(cherry picked from commit 237be358a2ecc406e9b8de89c1978eed5b0eabe6)
---
 common/private/appdomain.te         | 1 -
 common/private/cameraserver.te      | 2 ++
 common/private/property_contexts    | 8 +++++---
 common/private/system_server.te     | 4 ++--
 common/public/property.te           | 2 --
 common/vendor/hal_camera_default.te | 2 +-
 6 files changed, 10 insertions(+), 9 deletions(-)
 delete mode 100644 common/private/appdomain.te
 create mode 100644 common/private/cameraserver.te
 delete mode 100644 common/public/property.te

diff --git a/common/private/appdomain.te b/common/private/appdomain.te
deleted file mode 100644
index 72760a6..0000000
--- a/common/private/appdomain.te
+++ /dev/null
@@ -1 +0,0 @@
-get_prop(appdomain, vendor_persist_camera_prop)
diff --git a/common/private/cameraserver.te b/common/private/cameraserver.te
new file mode 100644
index 0000000..2193460
--- /dev/null
+++ b/common/private/cameraserver.te
@@ -0,0 +1,2 @@
+# Let cameraserver find camera properties
+get_prop(cameraserver, camera2_extensions_prop)
diff --git a/common/private/property_contexts b/common/private/property_contexts
index 339b0f7..1c7a28a 100644
--- a/common/private/property_contexts
+++ b/common/private/property_contexts
@@ -1,6 +1,8 @@
-# Aux camera
-vendor.camera.aux.packageblacklist   u:object_r:vendor_persist_camera_prop:s0
-vendor.camera.aux.packagelist          u:object_r:vendor_persist_camera_prop:s0
+# Camera
+persist.vendor.camera.privapp.list     u:object_r:camera2_extensions_prop:s0
+vendor.camera.aux.packageblacklist     u:object_r:camera2_extensions_prop:s0
+vendor.camera.aux.packageexcludelist   u:object_r:camera2_extensions_prop:s0
+vendor.camera.aux.packagelist          u:object_r:camera2_extensions_prop:s0
 
 # Radio
 ro.telephony.use_old_mnc_mcc_format    u:object_r:telephony_config_prop:s0
diff --git a/common/private/system_server.te b/common/private/system_server.te
index 686dcce..9cf8348 100644
--- a/common/private/system_server.te
+++ b/common/private/system_server.te
@@ -9,8 +9,8 @@ allow system_server pocket_judge_sysfs:file rw_file_perms;
 hal_client_domain(system_server, hal_lineage_touch)
 hal_client_domain(system_server, hal_lineage_powershare)
 
-# Let system server find auxiliary camera properties
-get_prop(system_server, vendor_persist_camera_prop)
+# Let system server find camera properties
+get_prop(system_server, camera2_extensions_prop)
 
 # Freeform
 add_service(system_server, lmo_freeform_service);
diff --git a/common/public/property.te b/common/public/property.te
deleted file mode 100644
index 72d8694..0000000
--- a/common/public/property.te
+++ /dev/null
@@ -1,2 +0,0 @@
-# Aux camera allow/excludelist prop
-system_vendor_config_prop(vendor_persist_camera_prop)
diff --git a/common/vendor/hal_camera_default.te b/common/vendor/hal_camera_default.te
index a305200..a5cd475 100644
--- a/common/vendor/hal_camera_default.te
+++ b/common/vendor/hal_camera_default.te
@@ -1,3 +1,3 @@
-get_prop(hal_camera_default, vendor_persist_camera_prop)
+get_prop(hal_camera_default, camera2_extensions_prop)
 get_prop(hal_camera_default, vendor_camera_skip_failed_ids_prop)
 set_prop(hal_camera_default, vendor_camera_remapid_prop)
