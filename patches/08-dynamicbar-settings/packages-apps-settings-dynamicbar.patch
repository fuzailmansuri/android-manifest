diff --git a/src/com/android/settings/display/DynamicBar.kt b/src/com/android/settings/display/DynamicBar.kt
new file mode 100644
index 0000000..ef06f1e
--- /dev/null
+++ b/src/com/android/settings/display/DynamicBar.kt
@@ -0,0 +1,220 @@
+package com.android.settings.display
+
+import android.content.ContentResolver
+import android.content.Context
+import android.database.ContentObserver
+import android.net.Uri
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.os.UserHandle
+import android.provider.Settings
+import androidx.preference.ListPreference
+import androidx.preference.Preference
+import androidx.preference.SwitchPreferenceCompat
+import android.app.settings.SettingsEnums
+import com.android.settings.R
+import com.android.settings.SettingsPreferenceFragment
+import com.android.settings.search.BaseSearchIndexProvider
+import com.android.settingslib.search.SearchIndexable
+import com.android.settingslib.widget.MainSwitchPreference
+import org.json.JSONArray
+
+@SearchIndexable
+class DynamicBar : SettingsPreferenceFragment() {
+
+    private val resolver: ContentResolver
+        get() = requireContext().contentResolver
+
+    private val handler = Handler(Looper.getMainLooper())
+    private var settingsObserver: ContentObserver? = null
+
+    private val eventTypeIds = listOf(
+        "media",
+        "charging",
+        "timer",
+        "stopwatch",
+        "alarm",
+        "bluetooth",
+        "torch",
+        "hotspot",
+        "ringer",
+        "vpn",
+        "clipboard",
+        "audio_recording",
+        "promoted_ongoing",
+        "sports",
+        "biometric_unlock",
+        "app_switch",
+    )
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        addPreferencesFromResource(R.xml.dynamic_bar_settings)
+
+        setupMainSwitch()
+        setupKeyguardPrefs()
+        setupEventToggles()
+        registerObserver()
+    }
+
+    override fun onDestroy() {
+        super.onDestroy()
+        settingsObserver?.let { resolver.unregisterContentObserver(it) }
+    }
+
+    private fun setupMainSwitch() {
+        val mainSwitch = findPreference<MainSwitchPreference>(SETTINGS_KEY_ENABLED)
+        val isEnabled = Settings.Secure.getIntForUser(
+            resolver, SETTINGS_KEY_ENABLED, 0, UserHandle.USER_CURRENT
+        ) == 1
+        mainSwitch?.isChecked = isEnabled
+        mainSwitch?.addOnSwitchChangeListener { _, isChecked ->
+            Settings.Secure.putIntForUser(
+                resolver, SETTINGS_KEY_ENABLED, if (isChecked) 1 else 0, UserHandle.USER_CURRENT
+            )
+            updateCategoryState(isChecked)
+        }
+        updateCategoryState(isEnabled)
+    }
+
+    private fun updateCategoryState(enabled: Boolean) {
+        findPreference<Preference>("dynamic_bar_keyguard_category")?.isEnabled = enabled
+        findPreference<Preference>("dynamic_bar_events_category")?.isEnabled = enabled
+    }
+
+    private fun setupKeyguardPrefs() {
+        val keyguardPref = findPreference<SwitchPreferenceCompat>(SETTINGS_KEY_KEYGUARD_ENABLED)
+        val keyguardEnabled = Settings.Secure.getIntForUser(
+            resolver, SETTINGS_KEY_KEYGUARD_ENABLED, 1, UserHandle.USER_CURRENT
+        ) == 1
+        keyguardPref?.isChecked = keyguardEnabled
+        keyguardPref?.setOnPreferenceChangeListener { _, newValue ->
+            val checked = newValue as Boolean
+            Settings.Secure.putIntForUser(
+                resolver, SETTINGS_KEY_KEYGUARD_ENABLED, if (checked) 1 else 0, UserHandle.USER_CURRENT
+            )
+            updateKeyguardSubPrefsVisibility(checked)
+            true
+        }
+
+        val batteryModePref = findPreference<ListPreference>(SETTINGS_KEY_BATTERY_CHIP_MODE)
+        val batteryMode = Settings.Secure.getIntForUser(
+            resolver, SETTINGS_KEY_BATTERY_CHIP_MODE, 1, UserHandle.USER_CURRENT
+        )
+        batteryModePref?.value = batteryMode.toString()
+        batteryModePref?.summary = batteryModePref?.entry
+        batteryModePref?.setOnPreferenceChangeListener { pref, newValue ->
+            val mode = (newValue as String).toIntOrNull() ?: 1
+            Settings.Secure.putIntForUser(
+                resolver, SETTINGS_KEY_BATTERY_CHIP_MODE, mode, UserHandle.USER_CURRENT
+            )
+            val index = (pref as ListPreference).findIndexOfValue(newValue)
+            if (index >= 0) {
+                pref.summary = pref.entries[index]
+            }
+            true
+        }
+
+        updateKeyguardSubPrefsVisibility(keyguardEnabled)
+    }
+
+    private fun updateKeyguardSubPrefsVisibility(keyguardEnabled: Boolean) {
+        findPreference<Preference>(SETTINGS_KEY_BATTERY_CHIP_MODE)?.isEnabled = keyguardEnabled
+    }
+
+    private fun setupEventToggles() {
+        val disabledEvents = getDisabledEvents()
+
+        for (typeId in eventTypeIds) {
+            val pref = findPreference<SwitchPreferenceCompat>("event_$typeId") ?: continue
+            pref.isChecked = typeId !in disabledEvents
+            pref.setOnPreferenceChangeListener { _, newValue ->
+                val enabled = newValue as Boolean
+                toggleEvent(typeId, enabled)
+                true
+            }
+        }
+    }
+
+    private fun getDisabledEvents(): Set<String> {
+        val json = Settings.Secure.getStringForUser(
+            resolver, SETTINGS_KEY_EVENTS, UserHandle.USER_CURRENT
+        ) ?: return emptySet()
+
+        if (json.isBlank()) return emptySet()
+
+        return try {
+            val arr = JSONArray(json)
+            (0 until arr.length()).mapTo(mutableSetOf()) { arr.getString(it) }
+        } catch (_: Exception) {
+            emptySet()
+        }
+    }
+
+    private fun toggleEvent(typeId: String, enabled: Boolean) {
+        val current = getDisabledEvents()
+        val updated = if (enabled) current - typeId else current + typeId
+        val json = if (updated.isEmpty()) "" else JSONArray(updated.toList()).toString()
+        Settings.Secure.putStringForUser(
+            resolver, SETTINGS_KEY_EVENTS, json, UserHandle.USER_CURRENT
+        )
+    }
+
+    private fun registerObserver() {
+        settingsObserver = object : ContentObserver(handler) {
+            override fun onChange(selfChange: Boolean, uri: Uri?) {
+                when (uri?.lastPathSegment) {
+                    SETTINGS_KEY_ENABLED -> {
+                        val isEnabled = Settings.Secure.getIntForUser(
+                            resolver, SETTINGS_KEY_ENABLED, 0, UserHandle.USER_CURRENT
+                        ) == 1
+                        findPreference<MainSwitchPreference>(SETTINGS_KEY_ENABLED)?.isChecked = isEnabled
+                        updateCategoryState(isEnabled)
+                    }
+                    SETTINGS_KEY_EVENTS -> {
+                        val disabledEvents = getDisabledEvents()
+                        for (typeId in eventTypeIds) {
+                            findPreference<SwitchPreferenceCompat>("event_$typeId")?.isChecked =
+                                typeId !in disabledEvents
+                        }
+                    }
+                    SETTINGS_KEY_KEYGUARD_ENABLED -> {
+                        val enabled = Settings.Secure.getIntForUser(
+                            resolver, SETTINGS_KEY_KEYGUARD_ENABLED, 1, UserHandle.USER_CURRENT
+                        ) == 1
+                        findPreference<SwitchPreferenceCompat>(SETTINGS_KEY_KEYGUARD_ENABLED)?.isChecked = enabled
+                        updateKeyguardSubPrefsVisibility(enabled)
+                    }
+                }
+            }
+        }
+
+        resolver.registerContentObserver(
+            Settings.Secure.getUriFor(SETTINGS_KEY_ENABLED),
+            false, settingsObserver!!
+        )
+        resolver.registerContentObserver(
+            Settings.Secure.getUriFor(SETTINGS_KEY_EVENTS),
+            false, settingsObserver!!
+        )
+        resolver.registerContentObserver(
+            Settings.Secure.getUriFor(SETTINGS_KEY_KEYGUARD_ENABLED),
+            false, settingsObserver!!
+        )
+    }
+
+    override fun getMetricsCategory(): Int {
+        return SettingsEnums.DISPLAY
+    }
+
+    companion object {
+        const val SETTINGS_KEY_ENABLED = "ax_dynamic_bar_enabled"
+        const val SETTINGS_KEY_KEYGUARD_ENABLED = "ax_dynamic_bar_keyguard_enabled"
+        const val SETTINGS_KEY_EVENTS = "ax_dynamic_bar_events"
+        const val SETTINGS_KEY_BATTERY_CHIP_MODE = "ax_dynamic_bar_keyguard_battery_chip_mode"
+
+        @JvmField
+        val SEARCH_INDEX_DATA_PROVIDER = BaseSearchIndexProvider(R.xml.dynamic_bar_settings)
+    }
+}
